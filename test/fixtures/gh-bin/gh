#!/usr/bin/env node
// Fake `gh` for outcome tests: answers from FAKE_GH_SCENARIO, never touches GitHub.
//   gh --version                     -> ok
//   gh pr view <branch> --json ...   -> scenario.view[<branch>] as JSON, else exit 1
//   gh pr list ...                   -> scenario.list (the merged revert-candidate PRs)
const fs = require('fs');
const args = process.argv.slice(2);
if (args[0] === '--version') { console.log('gh version 0.0.0-fake'); process.exit(0); }
const scen = process.env.FAKE_GH_SCENARIO ? JSON.parse(fs.readFileSync(process.env.FAKE_GH_SCENARIO, 'utf8')) : {};
if (args[0] === 'pr' && args[1] === 'view') {
  const pr = (scen.view || {})[args[2]];
  if (!pr) { console.error('no pull requests found for branch'); process.exit(1); }
  console.log(JSON.stringify(pr));
  process.exit(0);
}
if (args[0] === 'pr' && args[1] === 'list') {
  if (scen.listFails) { console.error('HTTP 502'); process.exit(1); }
  console.log(JSON.stringify(scen.list || []));
  process.exit(0);
}
console.error(`fake gh: unsupported ${args.join(' ')}`);
process.exit(2);
